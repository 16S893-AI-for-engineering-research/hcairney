---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const entries = (await getCollection("devLog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Dev log">
  <h1 class="text-3xl font-bold mb-2">Dev log</h1>
  <p class="text-slate-400 mb-8">
    Notes on how I'm using an AI coding agent this semester — what I tried,
    what worked, what didn't.
  </p>

  <ul class="space-y-4">
    {entries.map((entry) => (
      <li class="border border-slate-800 rounded-lg p-4 hover:border-amber-400 transition-colors">
        <a href={`${base}dev-log/${entry.id}/`} class="block">
          <p class="text-xs font-mono text-slate-500">
            {entry.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
          </p>
          <h2 class="text-lg font-semibold text-amber-300">{entry.data.title}</h2>
          {entry.data.summary && <p class="text-slate-400 mt-1">{entry.data.summary}</p>}
        </a>
      </li>
    ))}
  </ul>

  {entries.length === 0 && (
    <p class="text-slate-500 italic">No entries yet — check back after week 1.</p>
  )}
</BaseLayout>
