---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="About">
  <h1 class="text-3xl font-bold mb-6">About me</h1>

  <div class="space-y-4 text-slate-300 leading-relaxed">
    <p>
      <!-- TODO: replace with your real bio -->
      I'm a graduate student at MIT working on [your research area]. This site
      is my portfolio for 16.S893 — AI Agents for Engineering Research — where
      I'll be documenting how I use coding agents on a real research problem
      over the course of the semester.
    </p>
    <p>
      <!-- TODO: background, interests, what got you into your field -->
      Outside of research, I'm interested in [interests]. I'm taking this class
      because [reason].
    </p>
  </div>

  <h2 class="text-xl font-semibold mt-10 mb-3">Why this class</h2>
  <p class="text-slate-300 leading-relaxed">
    <!-- TODO -->
    A short note on what you hope to get out of 16.S893, separate from the
    project itself — e.g. what you want to learn about working with agents.
  </p>
</BaseLayout>
